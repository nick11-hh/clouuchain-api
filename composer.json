{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "require": {
        "php": "^8.1.17",
        "ext-bcmath": "*",
        "ext-libxml": "*",
        "ext-openssl": "*",
        "ext-simplexml": "*",
        "ext-xlswriter": "*",
        "bacon/bacon-qr-code": "^2.0",
        "barryvdh/laravel-snappy": "^1.0",
        "doctrine/dbal": "^3.10",
        "google/cloud-translate": "^2.1",
        "guzzlehttp/guzzle": "^7.2",
        "h4cc/wkhtmltoimage-amd64": "^0.12.4",
        "h4cc/wkhtmltopdf-amd64": "^0.12.4",
        "iidestiny/laravel-filesystem-oss": "3.1",
        "khanamiryan/qrcode-detector-decoder": "^2.0",
        "khsing/world": "^9.0",
        "laravel/framework": "^9.19",
        "laravel/horizon": "^5.24",
        "laravel/passport": "^12.0",
        "laravel/sanctum": "^3.0",
        "laravel/tinker": "^2.7",
        "league/omnipay": "^3.2",
        "maatwebsite/excel": "^3.1",
        "mavinoo/laravel-batch": "^2.3",
        "mews/captcha": "^3.3",
        "milon/barcode": "^10.0",
        "moneyphp/money": "^4.5",
        "omnipay/paypal": "^3.0",
        "osiset/laravel-shopify": "17.3.2",
        "overtrue/flysystem-cos": "^5.1",
        "overtrue/laravel-filesystem-cos": "^3.4",
        "paypal/rest-api-sdk-php": "*",
        "php-open-source-saver/jwt-auth": "^2.1",
        "phpoffice/phpword": "^1.3",
        "picqer/php-barcode-generator": "^2.4",
        "php-amqplib/php-amqplib": "^3.2",
        "salla/ouath2-merchant": "^2.0",
        "setasign/fpdi": "^2.6",
        "shopify/shopify-api": "^5.1",
        "spatie/laravel-multitenancy": "^3.0",
        "spatie/laravel-translatable": "^6.5",
        "stichoza/google-translate-php": "^5.1"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^2.15",
        "fakerphp/faker": "^1.9.1",
        "kitloong/laravel-migrations-generator": "^6.9",
        "laravel/pint": "^1.0",
        "laravel/sail": "^1.0.1",
        "laravel/telescope": "^4.16",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^6.1",
        "phpunit/phpunit": "^9.5.10",
        "spatie/laravel-ignition": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
